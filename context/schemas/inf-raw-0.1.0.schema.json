{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leanhvu-ktnn/RAW_WIKIPEDIA/schemas/inf-raw/0.1.0/exchange.schema.json",
  "title": "INF–RAW Wikipedia exchange (draft 0.1.0)",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/report"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "okf_version": {
          "const": "0.2"
        },
        "message_type": {
          "const": "request"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "const": "INF"
        },
        "consumer": {
          "const": "RAW_WIKIPEDIA"
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "source_uri": {
              "type": "string",
              "format": "uri"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "version",
            "source_uri",
            "sha256"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "request_item_id": {
                "type": "string",
                "minLength": 1
              },
              "inf_ref": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "namespace": {
                    "type": "string",
                    "format": "uri"
                  },
                  "entity_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "entity_type": {
                    "enum": [
                      "DiaBan",
                      "CoQuan"
                    ]
                  }
                },
                "required": [
                  "namespace",
                  "entity_id",
                  "entity_type"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "administrative_code": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "agency_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "administrative_level": {
                "enum": [
                  "TW",
                  "tinh",
                  "xa",
                  "huyen",
                  null
                ]
              },
              "parent_inf_ref": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "namespace": {
                        "type": "string",
                        "format": "uri"
                      },
                      "entity_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "entity_type": {
                        "enum": [
                          "DiaBan",
                          "CoQuan"
                        ]
                      }
                    },
                    "required": [
                      "namespace",
                      "entity_id",
                      "entity_type"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "as_of": {
                "type": "string",
                "format": "date"
              },
              "missing_fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "known_sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "search_hints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "request_item_id",
              "inf_ref",
              "label",
              "administrative_code",
              "agency_id",
              "administrative_level",
              "parent_inf_ref",
              "as_of",
              "missing_fields",
              "known_sources",
              "search_hints"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "okf_version",
        "message_type",
        "message_id",
        "request_id",
        "created_at",
        "producer",
        "consumer",
        "catalog",
        "items"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "okf_version": {
          "const": "0.2"
        },
        "message_type": {
          "const": "report"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "const": "RAW_WIKIPEDIA"
        },
        "consumer": {
          "const": "INF"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "final": {
          "type": "boolean"
        },
        "inf_action": {
          "const": "review_only"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "request_item_id": {
                "type": "string",
                "minLength": 1
              },
              "inf_ref": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "namespace": {
                    "type": "string",
                    "format": "uri"
                  },
                  "entity_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "entity_type": {
                    "enum": [
                      "DiaBan",
                      "CoQuan"
                    ]
                  }
                },
                "required": [
                  "namespace",
                  "entity_id",
                  "entity_type"
                ]
              },
              "status": {
                "enum": [
                  "found",
                  "not_found",
                  "ambiguous",
                  "error"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "queries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "candidate_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "page": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "wiki_id": {
                          "const": "viwiki"
                        },
                        "page_id": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_url": {
                          "type": "string",
                          "pattern": "^https://vi\\.wikipedia\\.org/"
                        }
                      },
                      "required": [
                        "wiki_id",
                        "page_id",
                        "title",
                        "source_url"
                      ]
                    },
                    "revision": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "revision_id": {
                              "type": "string",
                              "pattern": "^[1-9][0-9]*$"
                            },
                            "revision_timestamp": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "revision_url": {
                              "type": "string",
                              "pattern": "^https://vi\\.wikipedia\\.org/w/index\\.php\\?oldid=[1-9][0-9]*$"
                            }
                          },
                          "required": [
                            "revision_id",
                            "revision_timestamp",
                            "revision_url"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "artifacts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "type": "string",
                            "pattern": "^sources/[^\\\\]+$"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "media_type": {
                            "type": "string",
                            "minLength": 1
                          },
                          "byte_length": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "retrieved_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "request_url": {
                            "type": "string",
                            "pattern": "^https://vi\\.wikipedia\\.org/w/api\\.php\\?"
                          },
                          "representation": {
                            "const": "mediawiki-api-response-bytes"
                          },
                          "license": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1
                          }
                        },
                        "required": [
                          "path",
                          "sha256",
                          "media_type",
                          "byte_length",
                          "retrieved_at",
                          "request_url",
                          "representation",
                          "license"
                        ]
                      }
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "conflicts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "candidate_id",
                    "page",
                    "revision",
                    "artifacts",
                    "evidence",
                    "conflicts"
                  ]
                }
              },
              "selected_candidate_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "missing_fields_unresolved": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "request_item_id",
              "inf_ref",
              "status",
              "reason",
              "queries",
              "candidates",
              "selected_candidate_id",
              "retryable",
              "missing_fields_unresolved"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "okf_version",
        "message_type",
        "message_id",
        "request_id",
        "created_at",
        "producer",
        "consumer",
        "request_sha256",
        "run_id",
        "final",
        "inf_action",
        "items"
      ]
    }
  }
}
